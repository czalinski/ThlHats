	(text "J30 (SPTD 1,5/4-H-3,5, double-level push-in): lower level 1-4 = OUT1-4 (+12 V when on),\nupper level 5-8 = 0 V (GND_RACK). Coils up to about 100 mA each; F30 1.1 A hold for all four."
		(exclude_from_sim no)
		(at 271.78 124.46 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "f6d5beae-2d5b-4189-a037-c69af39b8e88")
	)
	(text "GPIO (requirements 4.1): four 3.3 V lines straight from core PIC32 pins (in or out). 330R in series and a\nBAT54S clamp to +3V3/GND at the card: ESD and a brief 5 V short only, NOT 24 V tolerant."
		(exclude_from_sim no)
		(at 25.4 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1db7bd10-d64e-4893-b396-a3f583bbadd5")
	)

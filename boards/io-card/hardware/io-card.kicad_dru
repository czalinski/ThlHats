(version 1)
# House custom DRC rules for low-cost 2-layer fabs (PCBWay standard service).
# Copied into each board by tools/new_board.py; edit tools/house_rules.kicad_dru
# for repo-wide changes.

(rule "PTH annular ring"
	(constraint annular_width (min 0.2mm))
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'"))

(rule "Hole to board edge"
	(constraint edge_clearance (min 0.5mm))
	(condition "A.isPlated() && A.Type == 'Via'"))

(rule "NPTH to copper"
	(constraint hole_clearance (min 0.3mm))
	(condition "A.Pad_Type == 'NPTH, mechanical'"))


# Samtec REF-182665 pass-through socket: Samtec's land pattern puts the pads
# close to the 0.97 mm pin holes. Allow 0.2 mm (PCBWay NPTH minimum) there.
(rule "REF-182665 NPTH to own pads"
	(constraint hole_clearance (min 0.2mm))
	(condition "A.Pad_Type == 'NPTH, mechanical' && A.memberOfFootprint('Thl_Connector:Samtec_REF-182665*')"))

# Its -01 locating-peg holes sit 0.42 mm from the adjacent pin holes
# (Samtec geometry). PCBWay's minimum is 0.4 mm.
(rule "REF-182665 peg hole spacing"
	(constraint hole_to_hole (min 0.4mm))
	(condition "A.memberOfFootprint('Thl_Connector:Samtec_REF-182665*') && B.memberOfFootprint('Thl_Connector:Samtec_REF-182665*')"))

# GCT USB4085 (through-hole USB-C 2.0): 0.4 mm drills on a 0.85 mm pitch leave a
# 0.15 mm annular ring (PCBWay standard minimum 0.15 mm). Allow it for this footprint only.
(rule "USB4085 annular ring"
	(constraint annular_width (min 0.15mm))
	(condition "A.Type == 'Pad' && A.memberOfFootprint('Connector_USB:USB_C_Receptacle_GCT_USB4085')"))

# Its 0.7 mm pads on a 0.85 mm pitch are 0.15 mm apart (the house track/space
# minimum) and the 0.4 mm drills 0.45 mm apart. Confirm the drill spacing with
# PCBWay when ordering.
(rule "USB4085 pad spacing"
	(constraint clearance (min 0.15mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('Connector_USB:USB_C_Receptacle_GCT_USB4085') && B.memberOfFootprint('Connector_USB:USB_C_Receptacle_GCT_USB4085')"))
(rule "USB4085 drill spacing"
	(constraint hole_to_hole (min 0.45mm))
	(condition "A.memberOfFootprint('Connector_USB:USB_C_Receptacle_GCT_USB4085') && B.memberOfFootprint('Connector_USB:USB_C_Receptacle_GCT_USB4085')"))

# Analog inputs (requirements 4.1): up to +-116 V per input between the J40
# terminal and the 10M resistors. IPC-2221B B4 (external, uncoated, 101-150 V)
# asks 0.6 mm; use 0.8 mm to every other net.
(rule "AI high voltage"
	(constraint clearance (min 0.8mm))
	(condition "A.NetName == '/AIN1P' || A.NetName == '/AIN1N' || A.NetName == '/AIN2P' || A.NetName == '/AIN2N'"))

# MCP4728 (U92, MSOP-10, 0.5 mm pitch): KiCad's land pattern leaves 0.15 mm
# between adjacent pads, the house track/space minimum.
(rule "MSOP-10 pad spacing"
	(constraint clearance (min 0.15mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('Package_SO:MSOP-10_3x3mm_P0.5mm') && B.memberOfFootprint('Package_SO:MSOP-10_3x3mm_P0.5mm')"))

# Stack connectors (J10/J11): through-hole ground pins are fed by the B.Cu
# plane; on F.Cu the pin rows leave room for one spoke only.
(rule "Stack connector spokes"
	(constraint min_resolved_spokes 1)
	(condition "A.memberOfFootprint('J1?')"))

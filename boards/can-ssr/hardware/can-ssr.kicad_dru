(version 1)
# House custom DRC rules for low-cost 2-layer fabs (PCBWay standard service).
# Copied into each board by tools/new_board.py; edit tools/house_rules.kicad_dru
# for repo-wide changes.

(rule "PTH annular ring"
	(constraint annular_width (min 0.2mm))
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'"))

(rule "Hole to board edge"
	(constraint edge_clearance (min 0.5mm))
	(condition "A.isPlated() && A.Type == 'Via'"))

(rule "NPTH to copper"
	(constraint hole_clearance (min 0.3mm))
	(condition "A.Pad_Type == 'NPTH, mechanical'"))


# Samtec REF-182665 pass-through socket: Samtec's land pattern puts the pads
# close to the 0.97 mm pin holes. Allow 0.2 mm (PCBWay NPTH minimum) there.
(rule "REF-182665 NPTH to own pads"
	(constraint hole_clearance (min 0.2mm))
	(condition "A.Pad_Type == 'NPTH, mechanical' && A.memberOfFootprint('Thl_Connector:Samtec_REF-182665*')"))

# Its -01 locating-peg holes sit 0.42 mm from the adjacent pin holes
# (Samtec geometry). PCBWay's minimum is 0.4 mm.
(rule "REF-182665 peg hole spacing"
	(constraint hole_to_hole (min 0.4mm))
	(condition "A.memberOfFootprint('Thl_Connector:Samtec_REF-182665*') && B.memberOfFootprint('Thl_Connector:Samtec_REF-182665*')"))

# ---- can-ssr high-voltage rules (up to 200 V working on the load side) ----
# Net classes (can-ssr.kicad_pro): HV = VIN, VOUT, VOUT_SW, divider internals;
# GD = gate-drive domain (G1-G4, GATE, SLEW, SRC, VOM_P, VOM_MID), which floats
# with the MOSFET sources. IPC-2221B B2 (external, uncoated) for 151-300 V is
# 1.25 mm; we use 1.5 mm. The CAN/logic to load barrier (y 42-48 mm) is a
# keep-out rule area on the board, not a rule here.
(rule "HV and gate drive to other nets"
	(constraint clearance (min 1.5mm))
	(condition "(A.NetClass == 'HV' || A.NetClass == 'GD') && B.NetClass != 'HV' && B.NetClass != 'GD'"))

(rule "VIN and Vin-divider nodes to gate drive and output"
	(constraint clearance (min 1.5mm))
	(condition "(A.NetName == 'VIN' || A.NetName == 'Net-(R34-Pad2)' || A.NetName == 'Net-(R35-Pad2)') && (B.NetClass == 'GD' || B.NetName == 'VOUT' || B.NetName == '/Power path/VOUT_SW')"))

# The return bar is clamped to the bottom copper between the S- and L- bolts
# (rule area RETBAR): only GND_LOAD copper may be there.
(rule "Only RET under the return bar"
	(constraint disallow track via)
	(condition "A.insideArea('RETBAR') && A.NetName != 'GND_LOAD'"))

# Stack interface (docs/requirements.md 4.4): the top-right standoff hole MH2 sits
# 4.45 mm from U40's pin-24 lead (a 7 mm A/F hex standoff reaches 4.04 mm). Only
# U40's rectangular courtyard corner, which is empty, overlaps the standoff circle.
(rule "Standoff MH2 beside U40"
	(constraint courtyard_clearance (min -1.2mm))
	(condition "A.Reference == 'MH2' && B.Reference == 'U40'"))

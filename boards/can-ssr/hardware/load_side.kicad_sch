	(text "Two MCP3426 (2 ch, +/-2.048 V): U32 0x68 (A0 suffix) Vin + PV readback, U36 0x69 (A1) Vout + PC\nreadback. Each converts its voltage continuously at 240 SPS (12 bit, ~0.125 V at 250 V FS):\nsupports 100 Hz reporting; 10 Hz can average to finer resolution. Readbacks read occasionally."
		(exclude_from_sim no)
		(at 160.02 121.92 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8c0809b5-af94-4862-b8e5-0102882ee6bf")
	)

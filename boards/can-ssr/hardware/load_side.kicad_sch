	(text "PV/PC: 0-5 V DAC outputs (rail-to-rail, VDD = V5_ISO), 1k series to the terminal.\n20k/10k readback into the ADC confirms the voltage at the terminal (open/short wiring).\nFirmware closes the loop on the measured Vin, so DAC accuracy does not matter."
		(exclude_from_sim no)
		(at 248.92 142.24 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "15c6884d-1bca-491d-9c45-610beefe61e0")
	)

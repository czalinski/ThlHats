	(text "VOM1271 LEDs (two in series, on the power-path sheet): +5V -> R27 -> LEDs -> Q21 -> Q22 -> GND.\nCurrent flows only when GATE_EN (firmware) AND TRIP_OK (hardware) are high: ~21 mA\n((5 - 2 x 1.4) V / 100 R), giving ~30 uA gate drive. R28 holds GATE_EN low at reset."
		(exclude_from_sim no)
		(at 243.84 119.38 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8a5736e0-8e50-4d14-a9dc-0368cc4084e2")
	)

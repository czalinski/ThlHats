	(text "J30: pin 5 = DB9-3 D+ (TI A/Y), 6 = DB9-8 D- (TI B/Z), 9 = DB9-5 GND_485_3.\nJP1: 120R termination, fit only at a bus end. U10: MODE = VISOOUT (5 V bus side,\nVDD from +5V); no copper within 4 mm of pins 11/12 except their own parts (SLLSF86D 9.4.1)."
		(exclude_from_sim no)
		(at 223.52 177.8 0)
